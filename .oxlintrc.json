{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["config/oxlint/rules-base.json", "config/oxlint/overrides.json"],
  "categories": { "correctness": "off" },
  "env": { "builtin": true, "es2026": true },
  "ignorePatterns": [
    "**/node_modules",
    "**/.DS_Store",
    "**/dist",
    "**/*.local",
    "**/.env",
    "**/.next",
    "**/.nitro",
    "**/.tanstack",
    "**/.wrangler",
    "**/.output",
    "**/.vinxi",
    "**/.content-collections",
    "**/.vite",
    "**/.nx/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/snap/**",
    "**/vite.config.*.timestamp-*.*",
    "eslint.config.*",
    "**/routeTree.gen.ts"
  ],
  "jsPlugins": [
    "@eslint-community/eslint-plugin-eslint-comments",
    "eslint-plugin-perfectionist",
    "@stylexjs/eslint-plugin"
  ],
  "settings": {
    "import-x/resolver": { "typescript": { "alwaysTryTypes": true } }
  }
}
